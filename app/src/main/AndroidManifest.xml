<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.appdev">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Splash Screen (Launcher Activity) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".UsernameActivity" />

        <!-- Home Activity -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />

        <!-- Simulator Activity -->
        <activity
            android:name=".SimulatorActivity"
            android:exported="false" />

        <activity
            android:name=".ResultActivity"
            android:exported="false" />

        <activity android:name=".TrafficLightSimulatorActivity" />

        <!-- Road Signs Activity -->
        <activity
            android:name=".RoadSignsActivity"
            android:exported="false" />

        <activity
            android:name=".TrafficRulesActivity"
            android:exported="false" />

        <activity
            android:name=".TurningOvertakingActivity"
            android:exported="false" />

        <activity android:name=".ChangingLanesActivity" />
        <activity android:name=".RightOfWayActivity" />
        <activity android:name=".YellowBoxActivity" />
        <activity android:name=".EmergencyVehicleActivity" />
        <activity android:name=".ParkingActivity" />
        <activity android:name=".HitchingActivity" />
        <activity android:name=".RedFlagLightsActivity" />
        <activity android:name=".UseRedFlagsActivity" />
        <activity android:name=".MufflersActivity" />
        <activity android:name=".TiresActivity" />
        <activity android:name=".RoadCrashActivity" />
        <activity android:name=".OtherDrivingRulesActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".EditProfileActivity" />

    </application>

</manifest>