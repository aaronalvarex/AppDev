<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SELECTED / CLICKED -->
    <item android:state_selected="true">

        <shape android:shape="rectangle">

            <solid android:color="#0B4ED8" />

            <corners android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#0B4ED8" />

            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp" />

        </shape>

    </item>


    <!-- NORMAL -->
    <item>

        <shape android:shape="rectangle">

            <solid android:color="#EEF4FF" />

            <corners android:radius="14dp" />

            <stroke
                android:width="1dp"
                android:color="#D6E5FF" />

            <padding
                android:left="8dp"
                android:top="4dp"
                android:right="8dp"
                android:bottom="4dp" />

        </shape>

    </item>

</selector>