<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:rotation="180"
                android:src="@drawable/ic_chevron_right"
                android:tint="#0052CC"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Red Flag Lights"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- DESCRIPTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="18dp"
            android:text="Rules on red lights used for loads extending beyond the vehicle."
            android:textColor="#555555"
            android:textSize="15sp" />

        <!-- RULE COUNT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:text="1 Rule"
            android:textColor="#0052CC"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- RULE 01 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_road_sign_card"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- NUMBER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01"
                android:textColor="#0052CC"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Red Flag Lights"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- RULE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Whenever the load of any vehicle extends more than one meter beyond the bed or body thereof, a red flag not less than thirty centimeters in length and width shall be displayed at every projecting end of the load. During the required nighttime hours, red lights visible at least fifty meters away shall be displayed instead of the red flags."
                android:textColor="#555555"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

            <!-- LIGHTING TIME -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="The red flag lights must be switched on not later than one-half hour after sunset and until at least one-half hour before sunrise, and whenever weather conditions require."
                android:textColor="#555555"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- SOURCE -->

    </LinearLayout>

</ScrollView>